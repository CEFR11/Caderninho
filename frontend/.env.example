# URL do backend Spring Boot. Use o IP da máquina (ex: http://192.168.0.10:8080)
# quando acessar o app de outro dispositivo na mesma rede.
VITE_API_URL=http://localhost:8080

# Nome da loja que assina as mensagens do WhatsApp (ex: Loja da Maria). Vazio = sem assinatura.
VITE_NOME_LOJA=

# Pix na cobrança e no extrato do WhatsApp. Sem a chave, as mensagens saem sem Pix.
# Prefira chave aleatória, e-mail ou CNPJ: a mensagem pode ser repassada e a chave fica pública.
VITE_PIX_CHAVE=
# Nome do titular e banco, para o cliente conferir no app do banco antes de pagar (opcionais).
VITE_PIX_NOME=
VITE_PIX_BANCO=
